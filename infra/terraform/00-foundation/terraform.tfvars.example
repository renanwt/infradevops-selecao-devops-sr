# Copie para terraform.tfvars (ignorado pelo git) e ajuste.

region      = "us-east-1"
project     = "comments-api"
environment = "dev"

# --- rede ---
vpc_cidr           = "10.0.0.0/16"
az_count           = 2
single_nat_gateway = true # false = 1 NAT por AZ (HA, ~2x custo)

# --- eks ---
kubernetes_version      = "1.35"
eks_public_access_cidrs = ["0.0.0.0/0"] # restrinja ao seu IP: ["203.0.113.10/32"]
node_instance_type      = "t3.small"
node_min_size           = 2
node_max_size           = 3
node_desired_size       = 2

# --- rds ---
db_instance_class        = "db.t4g.micro"
db_multi_az              = false
db_backup_retention_days = 1
db_deletion_protection   = false # producao: true
db_skip_final_snapshot   = true  # producao: false

# --- iam / ci ---
github_repository = "renanwt/infradevops-selecao-devops-sr"
tfstate_bucket    = "comments-api-tfstate-208597681536"
app_namespace     = "comments"
github_actions_can_apply = false # true = apply pelo pipeline (AdministratorAccess)

# --- custo ---
budget_limit_usd = 15
budget_email     = "" # e-mail para alerta de orcamento; vazio desliga
