          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_request_duration_seconds_bucket{job=\"comments-api\", namespace=\"$namespace\", route=~\"/api/.*\", le=\"0.3\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"comments-api\", namespace=\"$namespace\", route=~\"/api/.*\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
